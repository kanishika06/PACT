# Supabase PostgreSQL connection string (session pooler or direct connection).
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# Leave unset to fall back to a local SQLite file (development only).
DATABASE_URL=your_supabase_postgresql_connection_string

# Gemini API key, used only by backend/services/ai_task_service.py (Member 3).
GEMINI_API_KEY=your_gemini_api_key

# Comma-separated list of allowed frontend origins.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
